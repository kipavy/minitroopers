{
  "name": "minitroopers",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "test": "node --test \"apps/*/test/**/*.test.ts\" \"packages/*/test/**/*.test.ts\" \"tools/*/test/**/*.test.ts\"",
    "typecheck": "tsc -b",
    "dev": "node --watch apps/server/src/main.ts",
    "start": "node apps/server/src/main.ts",
    "admin": "node apps/server/src/admin/cli.ts",
    "test:play": "node tools/oracle/scripts/test-play.mjs",
    "oracle:capture": "node tools/oracle/src/capture.ts",
    "oracle:coverage": "node tools/oracle/src/coverage.ts",
    "oracle:diff": "node tools/oracle/src/diff.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
