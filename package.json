{
  "name": "minitroopers",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "test": "node --test \"packages/*/test/**/*.test.ts\" \"tools/*/test/**/*.test.ts\"",
    "typecheck": "tsc -b",
    "oracle:capture": "node tools/oracle/src/capture.ts",
    "oracle:coverage": "node tools/oracle/src/coverage.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
